# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM provider (OpenRouter or any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter
LLM_MODEL=x-ai/grok-4.3
# Optional: used automatically when LLM_MODEL is unavailable (e.g. the
# provider balance is empty) or when it returns an unfinished turn.
# Comma separated, tried in order. Leave empty to disable the fallback.
LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3.1-flash:free
# Upstream HTTP timeout (seconds).
LLM_TIMEOUT_SECONDS=90

TAVILY_API_KEY=your_tavily_api_key_here

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Every API route requires a valid Clerk token unless this is explicitly false.
# Never disable it in production.
AUTH_REQUIRED=true
# Clerk issuer of your application.
# Derive it from the publishable key: base64url("<instance>.clerk.accounts.dev$")
# Session tokens are verified against Clerk's public JWKS.
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWT_AUDIENCE=clerk

# ---------------------------------------------------------------------------
# HTTP, storage and limits
# ---------------------------------------------------------------------------
# Comma separated list of allowed browser origins. Required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
NEXUSAI_DB_PATH=./nexusai.db
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_HISTORY_TURNS=10
