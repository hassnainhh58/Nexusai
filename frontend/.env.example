# Clerk publishable key (safe to expose to the browser).
# Find it in the Clerk dashboard -> API Keys -> Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional: absolute URL of the backend. Leave empty to use the Vite dev
# proxy (same-origin requests, no CORS involved).
VITE_API_URL=
